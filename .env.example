# Copy to .env and fill in. Never commit .env.

# --- AI assistant ---------------------------------------------------------------
# Easiest: choose the provider and enter its key in the app (Admin > AI assistant).
# Alternatively set ONE of these here:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# CDP_AI_PROVIDER=gemini          # which one to use if several are set and nothing is saved in the UI

# --- Platform ------------------------------------------------------------------
# CDP_AS_OF=today                 # "today" in production; a fixed date for demos
# CDP_REFRESH_MINUTES=360         # scheduler interval (docker compose)
CDP_ADMIN_PASSWORD=               # required: protects the Admin screens
CDP_SECRET_KEY=                   # required: encrypts stored credentials (python -m cdp secret-key)

# --- Source credentials (names are referenced by connection_env / ${VAR} in config/tenants/*.json)
# ACME_SQLSERVER=Driver={ODBC Driver 18 for SQL Server};Server=tcp:host,1433;Database=Sales;Uid=reader;Pwd=...;Encrypt=yes
# ACME_POSTGRES=host=db.example.com dbname=crm user=reader password=...
# ACME_HELPDESK_TOKEN=...
# AZURE_STORAGE_CONNECTION_STRING=...
# AWS_ACCESS_KEY_ID=... / AWS_SECRET_ACCESS_KEY=... / AWS_REGION=...
